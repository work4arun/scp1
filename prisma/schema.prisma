// Strategic Control Portal — Prisma schema
// Postgres + Prisma. Run: npx prisma db push (or migrate dev) then npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
// Roles & Users
// ────────────────────────────────────────────────────────────

enum SystemRole {
  SUPER_ADMIN
  CBO
  SM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  systemRole   SystemRole
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdTasks    Task[]          @relation("TaskCreator")
  cboNotes        CboNote[]
  taskUpdates     TaskUpdate[]
  pins            Pin[]
  auditLogs       AuditLog[]

  @@index([systemRole])
}

// ────────────────────────────────────────────────────────────
// Teams & Members
// ────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         TeamMember[]
  taskAssignments TaskTeamAssignment[]

  @@index([active])
}

model TeamMember {
  id          String  @id @default(cuid())
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  email       String
  designation String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  taskAssignments TaskAssignment[]

  @@unique([teamId, email])
  @@index([teamId])
  @@index([email])
}

// Junction: team assigned to a task (with email toggle)
model TaskTeamAssignment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sendEmail Boolean  @default(true) // default: send email to all team members
  assignedAt DateTime @default(now())

  @@unique([taskId, teamId])
  @@index([taskId])
  @@index([teamId])
}

// Junction: individual member assignment to a task (with email toggle)
model TaskAssignment {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sendEmail Boolean    @default(true) // default: send email to this member
  assignedAt DateTime   @default(now())

  @@unique([taskId, memberId])
  @@index([taskId])
  @@index([memberId])
}


// CBO can pin tasks/verticals to keep them visible across sessions.
model Pin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // "task" | "vertical"
  refId     String   // id of the referenced entity
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId])
}

// Light global audit log
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  note      String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action])
}

// Feature Flags
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  category    String   @default("general")
  label       String
  description String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([category])
}

// ────────────────────────────────────────────────────────────
// Verticals & Sub-Verticals
// ────────────────────────────────────────────────────────────

model Vertical {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  colorHex    String  @default("#4f46e5")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subVerticals SubVertical[]
  tasks        Task[]
}

model SubVertical {
  id          String  @id @default(cuid())
  name        String
  description String?
  verticalId  String
  vertical    Vertical @relation(fields: [verticalId], references: [id], onDelete: Cascade)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  tasks Task[]

  @@unique([verticalId, name])
  @@index([verticalId])
}

// ────────────────────────────────────────────────────────────
// Priority
// ────────────────────────────────────────────────────────────

model Priority {
  id            String  @id @default(cuid())
  code          String  @unique
  label         String
  description   String?
  reviewCadence String?
  colorHex      String  @default("#6b7280")
  rank          Int
  active        Boolean @default(true)

  tasks Task[]
}

// ────────────────────────────────────────────────────────────
// Status & Source enums
// ────────────────────────────────────────────────────────────

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  DELAYED
  COMPLETED
  PARKED
  DROPPED
}

enum TaskSource {
  BOSS_INSTRUCTION
  WHATSAPP_GROUP
  MANAGEMENT_MEETING
  DEPARTMENT_MEETING
  MARKETING_REVIEW
  MRM
  PLACEMENT_REVIEW
  RTC_REVIEW
  DIGITAL_REVIEW
  SELF_STRATEGY
  NEW_IDEA
}

enum InterventionFlag {
  NO
  YES
  ONLY_IF_DELAYED
}

// ────────────────────────────────────────────────────────────
// Tasks
// ────────────────────────────────────────────────────────────

model Task {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String?
  verticalId      String
  vertical        Vertical @relation(fields: [verticalId], references: [id])
  subVerticalId   String?
  subVertical     SubVertical? @relation(fields: [subVerticalId], references: [id])
  priorityId      String
  priority        Priority @relation(fields: [priorityId], references: [id])
  status          TaskStatus @default(NOT_STARTED)
  source          TaskSource @default(SELF_STRATEGY)
  // Multi-team assignment
  teamAssignments TaskTeamAssignment[]
  // Individual member assignments
  assignees       TaskAssignment[]
  createdById     String
  createdBy       User     @relation("TaskCreator", fields: [createdById], references: [id])
  deadline        DateTime?
  frequency       String?
  supportNeeded   String?
  delayReason     String?
  nextAction      String?
  intervention    InterventionFlag @default(NO)
  expectedOutput  String?
  lastUpdateAt    DateTime?
  droppedAt       DateTime?
  dropReason      String?
  slaDueAt        DateTime?
  slaBreachedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cboNotes       CboNote[]
  updates        TaskUpdate[]

  @@index([verticalId, status])
  @@index([priorityId])
  @@index([droppedAt])
}

// CBO notes (voice + text)
model CboNote {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  kind         String   // "text" | "voice"
  text         String?
  audioBytes   Bytes?
  audioMime    String?
  audioDurationS Int?
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

model TaskUpdate {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
  note      String
  newStatus TaskStatus?
  createdAt DateTime @default(now())

  @@index([taskId])
}