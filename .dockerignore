# ─────────────────────────────────────────────────────────────────────────────
#  .dockerignore — what Docker should NEVER copy into the build context
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies — installed fresh inside the image
node_modules
**/node_modules

# Build artifacts — regenerated by `next build`
.next
out
dist
build
coverage

# TypeScript incremental cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Version control
.git
.gitignore
.gitattributes

# Local env files — secrets must come from compose / runtime env
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs

# OS / editor cruft
.DS_Store
.vscode
.idea
*.swp
*.swo
Thumbs.db

# Docs — not needed at runtime
README.md
DEPLOYMENT.md
DEPLOYMENT_GUIDE.md
DIAGNOSIS_REPORT.md
*.md
!prisma/**/*.md

# Tests and CI metadata
.github
.circleci
.gitlab-ci.yml
test
tests
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Misc
.npm
.cache
.parcel-cache
.turbo
.vercel
tmp
temp

# Graphify analysis
graphify-out

# Docker stuff itself
.dockerignore
Dockerfile
docker-compose.yml

# Obsolete deploy folder (files now at root)
scp-deploy