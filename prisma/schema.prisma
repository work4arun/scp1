generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  CBO
  SM
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  systemRole   SystemRole
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdTasks    Task[]          @relation("TaskCreator")
  cboNotes        CboNote[]
  taskUpdates     TaskUpdate[]
  pins            Pin[]
  auditLogs       AuditLog[]

  @@index([systemRole])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         TeamMember[]
  taskAssignments TaskTeamAssignment[]

  @@index([active])
}

model TeamMember {
  id          String  @id @default(cuid())
  teamId      String
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  email       String
  designation String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  taskAssignments TaskAssignment[]
  accessTokens    ExternalAccessToken[]

  @@unique([teamId, email])
  @@index([teamId])
  @@index([email])
}

model TaskTeamAssignment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sendEmail Boolean  @default(true)
  assignedAt DateTime @default(now())

  @@unique([taskId, teamId])
  @@index([taskId])
  @@index([teamId])
}

model TaskAssignment {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sendEmail Boolean    @default(true)
  assignedAt DateTime   @default(now())

  @@unique([taskId, memberId])
  @@index([taskId])
  @@index([memberId])
}

model Pin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  refId     String
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  note      String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  category    String   @default("general")
  label       String
  description String
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([category])
}

model SmtpConfig {
  id        String  @id @default("default")
  host      String
  port      Int     @default(587)
  secure    Boolean @default(false)
  user      String
  pass      String
  from      String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  recipient   String
  subject     String
  status      String   @default("pending")
  listmonkId  String?
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([status])
  @@index([createdAt])
}

model ExternalAccessToken {
  id        String   @id @default(cuid())
  token     String   @unique
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([token])
  @@index([memberId])
  @@index([taskId])
}

model TaskMessage {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  authorName  String   @default("")
  authorRole  String   @default("member")
  text        String?
  audioBytes  Bytes?
  audioMime   String?
  audioDurationS Int?
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}

model Vertical {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  colorHex    String  @default("#4f46e5")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks        Task[]
}

model Priority {
  id            String  @id @default(cuid())
  code          String  @unique
  label         String
  description   String?
  reviewCadence String?
  colorHex      String  @default("#6b7280")
  rank          Int
  active        Boolean @default(true)

  tasks Task[]
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  DELAYED
  COMPLETED
  PARKED
  DROPPED
}

enum TaskSource {
  BOSS_INSTRUCTION
  WHATSAPP_GROUP
  MANAGEMENT_MEETING
  DEPARTMENT_MEETING
  MARKETING_REVIEW
  MRM
  PLACEMENT_REVIEW
  RTC_REVIEW
  DIGITAL_REVIEW
  SELF_STRATEGY
  NEW_IDEA
}

enum InterventionFlag {
  NO
  YES
  ONLY_IF_DELAYED
}

model Task {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  description     String?
  verticalId      String
  vertical        Vertical @relation(fields: [verticalId], references: [id])
  priorityId      String
  priority        Priority @relation(fields: [priorityId], references: [id])
  status          TaskStatus @default(NOT_STARTED)
  source          TaskSource @default(SELF_STRATEGY)
  teamAssignments TaskTeamAssignment[]
  assignees       TaskAssignment[]
  createdById     String
  createdBy       User     @relation("TaskCreator", fields: [createdById], references: [id])
  deadline        DateTime?
  frequency       String?
  supportNeeded   String?
  delayReason     String?
  nextAction      String?
  intervention    InterventionFlag @default(NO)
  expectedOutput  String?
  lastUpdateAt    DateTime?
  droppedAt       DateTime?
  dropReason      String?
  slaDueAt        DateTime?
  slaBreachedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cboNotes       CboNote[]
  emailLogs      EmailLog[]
  updates        TaskUpdate[]
  accessTokens   ExternalAccessToken[]
  messages       TaskMessage[]

  @@index([verticalId, status])
  @@index([priorityId])
  @@index([droppedAt])
}

model StaticPage {
  id          String   @id @default(cuid())
  pageName    String
  fileName    String
  fileType    String   // "pdf" | "html" | "ppt"
  fileData    Bytes
  verticalId  String?
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([verticalId])
  @@index([createdAt])
}

model CboNote {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  kind         String
  text         String?
  audioBytes   Bytes?
  audioMime    String?
  audioDurationS Int?
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

model TaskUpdate {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
  note      String
  newStatus TaskStatus?
  createdAt DateTime @default(now())

  @@index([taskId])
}